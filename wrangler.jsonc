{
  "$schema": "node_modules/wrangler/config-schema.json",
  /*
   * One Worker for everything: it serves the built site from dist/ and hosts
   * the grand map, a Durable Object, on /party/*. Deploy with `bun run deploy`.
   */
  "name": "rising-tide",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    /* A client-side app: unknown paths get index.html. */
    "not_found_handling": "single-page-application",
    /* The room's paths go to the Worker; everything else is a static file. */
    "run_worker_first": ["/party/*", "/party-status"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TideRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TideRoom"] }],
  "vars": {
    /* Comma-separated origins allowed to open the room's socket. Empty allows all. */
    "ALLOWED_ORIGINS": ""
  }
}
