{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rising-tide",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "TideRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TideRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": ""
  }
}
